  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set base_url if not configured",
          "if (!pm.environment.get('base_url') && !pm.globals.get('base_url')) {",
          "    pm.globals.set('base_url', 'http://localhost:3000');",
          "}",
          "",
          "// Auto-set test email if not configured", 
          "if (!pm.environment.get('test_email') && !pm.globals.get('test_email')) {",
          "    pm.globals.set('test_email', 'test@example.com');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Response validation",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "// Validate structured image response for GET requests",
          "if (pm.request.method === 'GET' && pm.response.code === 200) {",
          "    const response = pm.response.json();",
          "    ",
          "    pm.test('Response has images array', function () {",
          "        pm.expect(response).to.have.property('images');",
          "        pm.expect(response.images).to.be.an('array');",
          "    });",
          "    ",
          "    pm.test('Response has imagesJson object', function () {",
          "        pm.expect(response).to.have.property('imagesJson');",
          "        pm.expect(response.imagesJson).to.be.an('object');",
          "    });",
          "    ",
          "    // Log the structured response for verification",
          "    console.log('Structured Images Response:');",
          "    console.log('Images Array:', response.images);",
          "    console.log('Images JSON:', response.imagesJson);",
          "}",
          "",
          "// Log response for debugging",
          "console.log('Response:', pm.response.json());"
        ]
      }
    }
  ]
}