    {
      "name": "3. Response Verification",
      "item": [
        {
          "name": "Get Profile - Verify Structured Response",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/{{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "{{test_email}}"]
            },
            "description": "Get profile and verify the response includes both:\n\n1. `images` array with all uploaded image URLs\n2. `imagesJson` object with structured format:\n\n```json\n{\n  \"images\": [\n    {\"url\": \"face_image_url\"},\n    {\"url\": \"fullbody_image_url\"},\n    {\"url\": \"smile_image_url\"},\n    {\"url\": \"extra1_image_url\"},\n    {\"url\": \"extra2_image_url\"}\n  ],\n  \"imagesJson\": {\n    \"face\": \"face_image_url\",\n    \"fullbody\": \"fullbody_image_url\",\n    \"toothyGrin\": \"smile_image_url\",\n    \"extras\": {\n      \"1\": \"extra1_image_url\",\n      \"2\": \"extra2_image_url\"\n    }\n  }\n}\n```"
          }
        },
        {
          "name": "Get Profile - Mixed Upload Response",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/mixed@example.com",
              "host": ["{{base_url}}"],
              "path": ["profile", "mixed@example.com"]
            },
            "description": "Verify mixed upload response includes both structured and regular image uploads"
          }
        }
      ]
