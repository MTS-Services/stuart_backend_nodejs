{
  "info": {
    "name": "Structured Image Upload API",
    "description": "Profile management with structured image file uploads (face, fullbody, toothyGrin, extras)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "structured-image-api-v3",
    "version": {
      "major": 3,
      "minor": 0,
      "patch": 0
    }
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "test@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Structured Image Uploads",
      "item": [
