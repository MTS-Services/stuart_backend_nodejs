    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "� Simple Registration (No Password)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email and name for testing",
                  "const timestamp = Date.now();",
                  "const testEmail = 'user_' + timestamp + '@example.com';",
                  "const names = ['Alex Johnson', 'Emma Smith', 'Michael Brown', 'Sarah Davis', 'James Wilson', 'Lisa Martinez'];",
                  "const testName = names[Math.floor(Math.random() * names.length)] + ' ' + timestamp.toString().slice(-3);",
                  "pm.globals.set('test_user_email', testEmail);",
                  "pm.globals.set('test_user_name', testName);",
                  "console.log('📝 Generated test user: ' + testName + ' (' + testEmail + ')');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registration successful', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.globals.set('user_id', response.user.id);",
                  "    console.log('✅ User registered with ID:', response.user.id);",
                  "    console.log('📧 Email:', response.user.email);",
                  "    console.log('📬 Admin will see this registration in pending list');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_user_email}}\",\n  \"name\": \"{{test_user_name}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "🔐 Admin Login",
