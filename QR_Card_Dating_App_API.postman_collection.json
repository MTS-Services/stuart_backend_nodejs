              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "login"]
            }
          }
        },
        {
          "name": "👥 Create Multiple Test Users",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set test users data",
                  "const testUsers = [",
                  "    { name: 'Alice Cooper', email: 'alice.test@example.com' },",
                  "    { name: 'Bob Smith', email: 'bob.test@example.com' },",
                  "    { name: 'Carol Johnson', email: 'carol.test@example.com' }",
                  "];",
                  "",
                  "// Start with first user",
                  "pm.globals.set('current_test_users', JSON.stringify(testUsers));",
                  "pm.globals.set('current_user_index', '0');",
                  "",
                  "const currentUser = testUsers[0];",
                  "pm.globals.set('bulk_test_email', currentUser.email);",
                  "pm.globals.set('bulk_test_name', currentUser.name);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Test user created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    console.log('✅ Created user:', response.user.name, '(ID:', response.user.id + ')');",
                  "    ",
                  "    // Create next user if available",
                  "    const testUsers = JSON.parse(pm.globals.get('current_test_users') || '[]');",
                  "    const currentIndex = parseInt(pm.globals.get('current_user_index') || '0');",
                  "    const nextIndex = currentIndex + 1;",
                  "    ",
                  "    if (nextIndex < testUsers.length) {",
                  "        pm.globals.set('current_user_index', nextIndex.toString());",
                  "        const nextUser = testUsers[nextIndex];",
                  "        pm.globals.set('bulk_test_email', nextUser.email);",
                  "        pm.globals.set('bulk_test_name', nextUser.name);",
                  "        ",
                  "        console.log('🔄 Creating next user:', nextUser.name);",
                  "        // Automatically run this request again for next user",
                  "        setTimeout(() => {",
                  "            pm.sendRequest({",
                  "                url: pm.request.url,",
                  "                method: 'POST',",
                  "                header: pm.request.headers,",
                  "                body: {",
                  "                    mode: 'raw',",
                  "                    raw: JSON.stringify({",
                  "                        email: nextUser.email,",
                  "                        name: nextUser.name",
                  "                    })",
                  "                }",
                  "            }, (err, res) => {",
                  "                if (!err && res.code === 201) {",
                  "                    console.log('✅ Bulk user created:', nextUser.name);",
                  "                }",
                  "            });",
                  "        }, 500);",
                  "    } else {",
                  "        console.log('🎉 All test users created successfully!');",
                  "        console.log('💡 Now check \"Get Pending User Registrations\" to see them');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
