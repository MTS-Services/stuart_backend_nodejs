# Coolify-optimized Dockerfile
FROM node:20-alpine AS base

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create app user
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install ALL dependencies (including dev for build)
RUN npm ci

# Copy source code
COPY . .

# Generate Prisma client (no migration during build)
RUN npx prisma generate

# Build the application
RUN npm run build

# Keep prisma for migrations, remove other dev dependencies
RUN npm prune --production && npm cache clean --force

# Create uploads directory
RUN mkdir -p uploads/profiles && chown -R nestjs:nodejs uploads && chown -R nestjs:nodejs /app

# Switch to non-root user
USER nestjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node healthcheck.js || exit 1

# Start with migrations then application
CMD ["dumb-init", "sh", "-c", "npx prisma migrate deploy && node dist/main"]