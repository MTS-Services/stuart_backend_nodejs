    {
      "name": "2. Profile Retrieval & Management",
      "item": [
        {
          "name": "Get Profile by Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/{{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "{{test_email}}"]
            },
            "description": "Retrieve profile information including images array and imagesJson structure"
          }
