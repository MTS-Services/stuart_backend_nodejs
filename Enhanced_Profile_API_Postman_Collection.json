        {
          "name": "Submit Profile for Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/profile/submit",
              "host": ["{{base_url}}"],
              "path": ["profile", "submit"]
            },
            "description": "Submit profile for admin review"
          }
        },
        {
          "name": "Delete Profile",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/profile/{{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["profile", "{{test_email}}"]
            },
            "description": "Delete entire profile by email"
          }
        }
      ]
