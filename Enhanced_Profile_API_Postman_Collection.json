{
  "info": {
    "name": "Profile Image Management API",
    "description": "Enhanced profile management with image upload, JSON structure, and comprehensive CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "enhanced-profile-api-v2",
    "version": {
      "major": 2,
      "minor": 0,
      "patch": 0
    }
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "test@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Profile Creation & Updates",
      "item": [
        {
          "name": "Create Profile with Structured Files",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data",
                "disabled": true
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "{{test_email}}",
                  "type": "text"
                },
                {
                  "key": "gmail",
                  "value": "test@gmail.com",
                  "type": "text"
                },
                {
                  "key": "userId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "age",
                  "value": "25",
                  "type": "text"
                },
                {
                  "key": "height",
                  "value": "5'10\"",
                  "type": "text"
                },
                {
                  "key": "bio",
                  "value": "This is a test bio that is longer than 10 characters for validation.",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "New York, NY",
                  "type": "text"
                },
                {
                  "key": "bodyType",
                  "value": "Athletic",
                  "type": "text"
                },
                {
                  "key": "county",
                  "value": "Manhattan",
                  "type": "text"
                },
                {
                  "key": "displayName",
                  "value": "Test User",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "+1234567890",
                  "type": "text"
                },
                {
                  "key": "face",
                  "value": "",
                  "type": "file",
                  "description": "Face image file (optional)"
                },
                {
                  "key": "fullbody",
                  "value": "",
                  "type": "file",
                  "description": "Full body image file (optional)"
                },
                {
                  "key": "toothyGrin",
                  "value": "",
                  "type": "file",
                  "description": "Toothy grin image file (optional)"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Extra image file 1 (optional)"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Extra image file 2 (optional)"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Extra image file 3 (optional)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/create-with-structured-files",
              "host": ["{{base_url}}"],
              "path": ["profile", "create-with-structured-files"]
            },
            "description": "Create a new profile with structured file uploads (face, fullbody, toothyGrin, extras)"
          }
        },
        {
          "name": "Update Profile with Structured Files - Merge Mode",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data",
                "disabled": true
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "{{test_email}}",
                  "type": "text"
                },
                {
                  "key": "bio",
                  "value": "Updated bio with new information about the user.",
                  "type": "text"
                },
                {
                  "key": "imageUpdateMode",
                  "value": "merge",
                  "type": "text",
                  "description": "Merge new images with existing ones"
                },
                {
                  "key": "face",
                  "value": "",
                  "type": "file",
                  "description": "New face image (optional)"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Additional extra image 1"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Additional extra image 2"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/update-with-structured-files",
              "host": ["{{base_url}}"],
              "path": ["profile", "update-with-structured-files"]
            },
            "description": "Update profile in merge mode - new structured images are added to existing ones"
          }
        },
        {
          "name": "Update Profile with Structured Files - Replace Mode",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data",
                "disabled": true
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "email",
                  "value": "{{test_email}}",
                  "type": "text"
                },
                {
                  "key": "imageUpdateMode",
                  "value": "replace",
                  "type": "text",
                  "description": "Replace all existing images with new ones"
                },
                {
                  "key": "face",
                  "value": "",
                  "type": "file",
                  "description": "New face image"
                },
                {
                  "key": "fullbody",
                  "value": "",
                  "type": "file",
                  "description": "New fullbody image"
                },
                {
                  "key": "toothyGrin",
                  "value": "",
                  "type": "file",
                  "description": "New toothy grin image"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "New extra image 1"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/profile/update-with-structured-files",
              "host": ["{{base_url}}"],
              "path": ["profile", "update-with-structured-files"]
            },
            "description": "Update profile in replace mode - all existing structured images are replaced with new ones"
          }
        }
      ]
