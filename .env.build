# Build-time environment variables
# Use these during the build process only

# Node Environment for Build
NODE_ENV=development

# Database - Use a placeholder for build (Prisma generate only)
DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder"

# JWT - Placeholder for build
JWT_SECRET="build_time_placeholder_jwt_secret"

# Required for Prisma Generate
FRONTEND_URL="https://placeholder.com"

# Email placeholders
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=placeholder@gmail.com
EMAIL_PASS=placeholder
FROM_EMAIL=placeholder@domain.com

# Payment placeholders
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
MOCK_PAYMENTS=true

# Image service placeholder
IMAGE_UPLOAD_SERVICE_URL=https://placeholder.com