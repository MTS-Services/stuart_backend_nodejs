                {
                  "key": "fullbody",
                  "value": "",
                  "type": "file",
                  "description": "Upload fullbody image file"
                },
                {
                  "key": "toothyGrin",
                  "value": "",
                  "type": "file",
                  "description": "Upload toothy grin/smile image file"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Upload extra image 1"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Upload extra image 2"
                },
                {
                  "key": "extras",
                  "value": "",
                  "type": "file",
                  "description": "Upload extra image 3"
                }
              ]
